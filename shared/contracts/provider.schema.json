{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://yingxu.local/contracts/provider.schema.json",
  "$defs":{
    "identifier":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$"},
    "version":{"const":"1.0"},
    "timestamp":{"type":"string","format":"date-time"},
    "rateLimit":{"type":"object","additionalProperties":false,"required":["requests_per_minute","concurrent_requests"],"properties":{"requests_per_minute":{"type":"integer","minimum":1,"maximum":1000000},"concurrent_requests":{"type":"integer","minimum":1,"maximum":10000}}},
    "configuration":{
      "type":"object","additionalProperties":false,
      "required":["provider_id","display_name","kind","endpoint","secret_reference","capabilities","enabled","timeout_seconds","rate_limit","settings","created_at","updated_at","contract_version"],
      "properties":{
        "provider_id":{"$ref":"#/$defs/identifier"},"display_name":{"type":"string","minLength":1,"maxLength":255},
        "kind":{"enum":["model","text","image","video","audio"]},
        "endpoint":{"type":"string","format":"uri","pattern":"^https://"},
        "secret_reference":{"type":"string","pattern":"^(env|vault|secret)://[A-Za-z0-9][A-Za-z0-9._/-]{0,1023}$"},
        "capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"}},
        "enabled":{"type":"boolean"},"timeout_seconds":{"type":"integer","minimum":1,"maximum":3600},
        "rate_limit":{"$ref":"#/$defs/rateLimit"},"settings":{"type":"object","propertyNames":{"not":{"pattern":"(?i)(api[_-]?key|secret|token|password|credential)"}}},
        "created_at":{"$ref":"#/$defs/timestamp"},"updated_at":{"$ref":"#/$defs/timestamp"},"contract_version":{"$ref":"#/$defs/version"}
      }
    },
    "health":{
      "type":"object","additionalProperties":false,
      "required":["provider_id","status","checked_at","latency_ms","error_code","consecutive_failures","circuit_open_until","contract_version"],
      "properties":{
        "provider_id":{"$ref":"#/$defs/identifier"},"status":{"enum":["unknown","healthy","degraded","unhealthy","disabled"]},
        "checked_at":{"$ref":"#/$defs/timestamp"},"latency_ms":{"type":["integer","null"],"minimum":0},
        "error_code":{"type":["string","null"],"pattern":"^[A-Z][A-Z0-9_]{0,127}$"},"consecutive_failures":{"type":"integer","minimum":0},
        "circuit_open_until":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},"contract_version":{"$ref":"#/$defs/version"}
      },
      "allOf":[{"if":{"properties":{"status":{"const":"healthy"}},"required":["status"]},"then":{"properties":{"error_code":{"type":"null"},"consecutive_failures":{"const":0},"circuit_open_until":{"type":"null"}}}}]
    }
  }
}
