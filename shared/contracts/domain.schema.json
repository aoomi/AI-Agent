{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yingxu.local/contracts/domain.schema.json",
  "title": "AI Agent V1 domain contracts",
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 255 },
    "timestamp": { "type": "string", "format": "date-time" },
    "version": { "const": "1.0" },
    "json_value": {
      "anyOf": [
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/json_value" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/json_value" } }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_id", "identity_kind", "display_name", "is_active", "created_at", "contract_version"],
      "properties": {
        "identity_id": { "$ref": "#/$defs/identifier" },
        "identity_kind": { "enum": ["user", "service", "agent"] },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "is_active": { "type": "boolean" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "contract_version": { "$ref": "#/$defs/version" }
      }
    },
    "authorization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_id", "identity_id", "tenant_id", "action", "scope_kind", "scope_id", "evaluated_at", "contract_version", "decision"],
          "properties": {
            "request_id": { "$ref": "#/$defs/identifier" },
            "identity_id": { "$ref": "#/$defs/identifier" },
            "tenant_id": { "$ref": "#/$defs/identifier" },
            "action": { "enum": ["identity.read", "project.read", "project.write", "task.read", "task.execute", "task.cancel", "plugin.read", "plugin.enable", "plugin.execute", "asset.read", "asset.write", "asset.export"] },
            "scope_kind": { "enum": ["identity", "project", "tenant", "platform"] },
            "scope_id": { "$ref": "#/$defs/identifier" },
            "evaluated_at": { "$ref": "#/$defs/timestamp" },
            "contract_version": { "$ref": "#/$defs/version" },
            "decision": { "const": "allowed" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_id", "identity_id", "tenant_id", "action", "scope_kind", "scope_id", "evaluated_at", "contract_version", "decision", "denial_reason"],
          "properties": {
            "request_id": { "$ref": "#/$defs/identifier" },
            "identity_id": { "$ref": "#/$defs/identifier" },
            "tenant_id": { "$ref": "#/$defs/identifier" },
            "action": { "enum": ["identity.read", "project.read", "project.write", "task.read", "task.execute", "task.cancel", "plugin.read", "plugin.enable", "plugin.execute", "asset.read", "asset.write", "asset.export"] },
            "scope_kind": { "enum": ["identity", "project", "tenant", "platform"] },
            "scope_id": { "$ref": "#/$defs/identifier" },
            "evaluated_at": { "$ref": "#/$defs/timestamp" },
            "contract_version": { "$ref": "#/$defs/version" },
            "decision": { "const": "denied" },
            "denial_reason": { "enum": ["UNAUTHENTICATED", "INACTIVE_IDENTITY", "PERMISSION_MISSING", "SCOPE_MISMATCH", "TENANT_MISMATCH", "RESOURCE_NOT_FOUND", "PLUGIN_DISABLED"] }
          }
        }
      ]
    },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "name", "status", "created_at", "contract_version"],
      "properties": {
        "tenant_id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "status": { "enum": ["inactive", "active", "suspended"] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "contract_version": { "$ref": "#/$defs/version" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "tenant_id", "owner_identity_id", "name", "status", "created_at", "updated_at", "contract_version"],
      "properties": {
        "project_id": { "$ref": "#/$defs/identifier" },
        "tenant_id": { "$ref": "#/$defs/identifier" },
        "owner_identity_id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "status": { "enum": ["draft", "active", "archived"] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "contract_version": { "$ref": "#/$defs/version" }
      }
    },
    "project_transition": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "tenant_id", "transition", "request_id", "operation_key", "actor_identity_id", "occurred_at", "contract_version"],
      "properties": {
        "project_id": { "$ref": "#/$defs/identifier" }, "tenant_id": { "$ref": "#/$defs/identifier" },
        "transition": { "enum": ["draft:active", "draft:archived", "active:archived", "archived:active"] },
        "request_id": { "$ref": "#/$defs/identifier" }, "operation_key": { "$ref": "#/$defs/identifier" },
        "actor_identity_id": { "$ref": "#/$defs/identifier" }, "occurred_at": { "$ref": "#/$defs/timestamp" },
        "contract_version": { "$ref": "#/$defs/version" }
      }
    },
    "task_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "tenant_id", "project_id", "transition", "request_id", "operation_key", "actor_identity_id", "occurred_at", "contract_version"],
      "properties": {
        "task_id": { "$ref": "#/$defs/identifier" },
        "tenant_id": { "$ref": "#/$defs/identifier" },
        "project_id": { "$ref": "#/$defs/identifier" },
        "transition": { "enum": ["queued:running", "queued:cancelled", "running:waiting_human", "running:paused", "running:completed", "running:failed", "running:cancelled", "waiting_human:running", "waiting_human:cancelled", "paused:queued", "paused:cancelled", "failed:queued", "failed:cancelled"] },
        "request_id": { "$ref": "#/$defs/identifier" },
        "operation_key": { "type": "string", "minLength": 1, "maxLength": 255 },
        "actor_identity_id": { "$ref": "#/$defs/identifier" },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "contract_version": { "$ref": "#/$defs/version" }
      }
    },
    "idempotency": {
      "oneOf": [
        { "$ref": "#/$defs/idempotency_accepted" },
        { "$ref": "#/$defs/idempotency_replayed" },
        { "$ref": "#/$defs/idempotency_conflict" }
      ]
    },
    "idempotency_accepted": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "operation_key", "request_fingerprint", "evaluated_at", "contract_version", "outcome", "task_id"],
      "properties": {
        "request_id": { "$ref": "#/$defs/identifier" }, "operation_key": { "$ref": "#/$defs/identifier" },
        "request_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "evaluated_at": { "$ref": "#/$defs/timestamp" },
        "contract_version": { "$ref": "#/$defs/version" }, "outcome": { "const": "accepted" }, "task_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "idempotency_replayed": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "operation_key", "request_fingerprint", "evaluated_at", "contract_version", "outcome", "task_id", "original_request_id"],
      "properties": {
        "request_id": { "$ref": "#/$defs/identifier" }, "operation_key": { "$ref": "#/$defs/identifier" },
        "request_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "evaluated_at": { "$ref": "#/$defs/timestamp" },
        "contract_version": { "$ref": "#/$defs/version" }, "outcome": { "const": "replayed" }, "task_id": { "$ref": "#/$defs/identifier" },
        "original_request_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "idempotency_conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "operation_key", "request_fingerprint", "evaluated_at", "contract_version", "outcome", "original_request_id"],
      "properties": {
        "request_id": { "$ref": "#/$defs/identifier" }, "operation_key": { "$ref": "#/$defs/identifier" },
        "request_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "evaluated_at": { "$ref": "#/$defs/timestamp" },
        "contract_version": { "$ref": "#/$defs/version" }, "outcome": { "const": "conflict" },
        "original_request_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "human_gate": {
      "oneOf": [
        { "$ref": "#/$defs/human_gate_pending" },
        { "$ref": "#/$defs/human_gate_resolved" }
      ]
    },
    "human_gate_pending": {
      "type": "object", "additionalProperties": false,
      "required": ["gate_id", "task_id", "tenant_id", "project_id", "gate_type", "status", "created_at", "contract_version"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/identifier" }, "task_id": { "$ref": "#/$defs/identifier" },
        "tenant_id": { "$ref": "#/$defs/identifier" }, "project_id": { "$ref": "#/$defs/identifier" },
        "gate_type": { "type": "string", "minLength": 1, "maxLength": 255 }, "status": { "const": "pending" },
        "created_at": { "$ref": "#/$defs/timestamp" }, "contract_version": { "$ref": "#/$defs/version" }
      }
    },
    "human_gate_resolved": {
      "type": "object", "additionalProperties": false,
      "required": ["gate_id", "task_id", "tenant_id", "project_id", "gate_type", "status", "created_at", "contract_version", "decided_by_identity_id", "decided_at"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/identifier" }, "task_id": { "$ref": "#/$defs/identifier" },
        "tenant_id": { "$ref": "#/$defs/identifier" }, "project_id": { "$ref": "#/$defs/identifier" },
        "gate_type": { "type": "string", "minLength": 1, "maxLength": 255 }, "status": { "enum": ["approved", "rejected"] },
        "created_at": { "$ref": "#/$defs/timestamp" }, "contract_version": { "$ref": "#/$defs/version" },
        "decided_by_identity_id": { "$ref": "#/$defs/identifier" }, "decided_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "tenant_id", "project_id", "operation_key", "task_type", "status", "progress_percent", "created_at", "updated_at", "contract_version"],
      "properties": {
        "task_id": { "$ref": "#/$defs/identifier" },
        "tenant_id": { "$ref": "#/$defs/identifier" },
        "project_id": { "$ref": "#/$defs/identifier" },
        "operation_key": { "type": "string", "minLength": 1, "maxLength": 255 },
        "task_type": { "type": "string", "minLength": 1, "maxLength": 255 },
        "status": { "enum": ["queued", "running", "waiting_human", "paused", "completed", "failed", "cancelled"] },
        "progress_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "contract_version": { "$ref": "#/$defs/version" }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_id", "name", "version", "source", "status", "compatible_platform_versions", "required_permissions", "contract_version"],
      "properties": {
        "plugin_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 255 },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "source": { "enum": ["builtin", "custom"] },
        "status": { "enum": ["discovered", "validated", "installed", "enabled", "disabled", "failed", "uninstalled"] },
        "compatible_platform_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "required_permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "contract_version": { "$ref": "#/$defs/version" }
      }
    },
    "plugin_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_id", "name", "version", "platform_version_range", "provider", "source", "capabilities", "permissions", "dependencies", "data_scopes", "frontend_slots", "backend_entry", "migration_entry", "uninstall_policy", "integrity_hash", "contract_version"],
      "properties": {
        "plugin_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 255 },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "platform_version_range": { "type": "string", "minLength": 1, "maxLength": 255 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 255 },
        "source": { "enum": ["builtin", "custom"] },
        "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" } },
        "permissions": { "type": "array", "uniqueItems": true, "items": { "enum": ["filesystem.read", "filesystem.write", "network.request", "model.invoke", "queue.publish", "queue.consume", "secret.read", "tenant_data.read", "tenant_data.write"] } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/plugin_dependency" } },
        "data_scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" } },
        "frontend_slots": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" } },
        "backend_entry": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$" },
        "migration_entry": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$" },
        "uninstall_policy": { "enum": ["retain", "export_then_remove"] },
        "integrity_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "contract_version": { "$ref": "#/$defs/version" }
      }
    },
    "plugin_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "kind"],
      "properties": {
        "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "kind": { "enum": ["required", "replaceable_input", "optional_enhancement"] },
        "provider_plugin_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      }
    },
    "plugin_transition": {
      "type": "object", "additionalProperties": false,
      "required": ["plugin_id", "transition", "request_id", "operation_key", "actor_identity_id", "occurred_at", "contract_version"],
      "properties": {
        "plugin_id": { "$ref": "#/$defs/identifier" },
        "transition": { "enum": ["discovered:validated", "discovered:failed", "validated:installed", "validated:failed", "installed:enabled", "installed:uninstalled", "enabled:disabled", "enabled:failed", "disabled:enabled", "disabled:uninstalled", "failed:disabled"] },
        "request_id": { "$ref": "#/$defs/identifier" }, "operation_key": { "$ref": "#/$defs/identifier" },
        "actor_identity_id": { "$ref": "#/$defs/identifier" }, "occurred_at": { "$ref": "#/$defs/timestamp" },
        "contract_version": { "$ref": "#/$defs/version" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "tenant_id", "project_id", "task_id", "asset_type", "status", "storage_key", "media_type", "byte_size", "checksum_sha256", "created_at", "contract_version"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/identifier" },
        "tenant_id": { "$ref": "#/$defs/identifier" },
        "project_id": { "$ref": "#/$defs/identifier" },
        "task_id": { "$ref": "#/$defs/identifier" },
        "asset_type": { "type": "string", "minLength": 1, "maxLength": 255 },
        "status": { "enum": ["pending", "available", "invalidated", "failed"] },
        "storage_key": { "type": "string", "minLength": 1, "maxLength": 1024, "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" } },
        "media_type": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "byte_size": { "type": "integer", "minimum": 0 },
        "checksum_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "contract_version": { "$ref": "#/$defs/version" }
      }
    },
    "asset_version": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_version_id", "asset_id", "tenant_id", "project_id", "task_id", "version_number", "parent_asset_version_id", "storage_key", "media_type", "byte_size", "checksum_sha256", "provenance", "created_at", "contract_version"],
      "properties": {
        "asset_version_id": { "$ref": "#/$defs/identifier" }, "asset_id": { "$ref": "#/$defs/identifier" },
        "tenant_id": { "$ref": "#/$defs/identifier" }, "project_id": { "$ref": "#/$defs/identifier" }, "task_id": { "$ref": "#/$defs/identifier" },
        "version_number": { "type": "integer", "minimum": 1 }, "parent_asset_version_id": { "type": "string", "maxLength": 255 },
        "storage_key": { "type": "string", "minLength": 1, "maxLength": 1024, "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" } },
        "media_type": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" }, "byte_size": { "type": "integer", "minimum": 0 },
        "checksum_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "provenance": { "$ref": "#/$defs/asset_provenance" },
        "created_at": { "$ref": "#/$defs/timestamp" }, "contract_version": { "$ref": "#/$defs/version" }
      }
    },
    "asset_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "provider_version", "model_id", "model_version", "prompt_version", "source_asset_version_ids"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 }, "provider_version": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string" }, "model_version": { "type": "string" }, "prompt_version": { "type": "string" },
        "source_asset_version_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "asset_invalidation": {
      "type": "object", "additionalProperties": false,
      "required": ["invalidation_id", "tenant_id", "project_id", "scope_kind", "scope_id", "affected_asset_version_ids", "reason", "preserve_history", "request_id", "actor_identity_id", "invalidated_at", "contract_version"],
      "properties": {
        "invalidation_id": { "$ref": "#/$defs/identifier" }, "tenant_id": { "$ref": "#/$defs/identifier" }, "project_id": { "$ref": "#/$defs/identifier" },
        "scope_kind": { "enum": ["asset", "episode", "scene", "shot", "dialogue", "time_window"] }, "scope_id": { "$ref": "#/$defs/identifier" },
        "affected_asset_version_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "reason": { "enum": ["UPSTREAM_CHANGED", "HUMAN_REJECTED", "GENERATION_FAILED", "MANUAL_REPLACEMENT"] }, "preserve_history": { "const": true },
        "request_id": { "$ref": "#/$defs/identifier" }, "actor_identity_id": { "$ref": "#/$defs/identifier" },
        "invalidated_at": { "$ref": "#/$defs/timestamp" }, "contract_version": { "$ref": "#/$defs/version" }
      }
    },
    "asset_export": {
      "type": "object", "additionalProperties": false,
      "required": ["export_id", "tenant_id", "project_id", "task_id", "asset_version_ids", "export_format", "status", "output_storage_key", "checksum_sha256", "request_id", "operation_key", "created_at", "updated_at", "contract_version"],
      "properties": {
        "export_id": { "$ref": "#/$defs/identifier" }, "tenant_id": { "$ref": "#/$defs/identifier" }, "project_id": { "$ref": "#/$defs/identifier" }, "task_id": { "$ref": "#/$defs/identifier" },
        "asset_version_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "export_format": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" }, "status": { "enum": ["queued", "running", "completed", "failed", "cancelled"] },
        "output_storage_key": { "type": "string", "maxLength": 1024, "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" } },
        "checksum_sha256": { "type": "string", "pattern": "^$|^[a-f0-9]{64}$" }, "request_id": { "$ref": "#/$defs/identifier" }, "operation_key": { "$ref": "#/$defs/identifier" },
        "created_at": { "$ref": "#/$defs/timestamp" }, "updated_at": { "$ref": "#/$defs/timestamp" }, "contract_version": { "$ref": "#/$defs/version" }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
        "then": {
          "properties": {
            "output_storage_key": { "type": "string", "minLength": 1, "maxLength": 1024, "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" } },
            "checksum_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "else": { "properties": { "output_storage_key": { "const": "" }, "checksum_sha256": { "const": "" } } }
      }]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "msg", "data", "timestamp"],
      "properties": {
        "code": { "enum": [400, 401, 403, 404, 409, 500] },
        "msg": { "type": "string", "minLength": 1, "maxLength": 255 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_id", "error_code", "details"],
          "properties": {
            "request_id": { "$ref": "#/$defs/identifier" },
            "error_code": { "enum": ["VALIDATION_ERROR", "UNAUTHENTICATED", "PERMISSION_DENIED", "RESOURCE_NOT_FOUND", "OPERATION_CONFLICT", "TASK_TIMEOUT", "DEPENDENCY_UNAVAILABLE", "INTERNAL_ERROR"] },
            "details": { "type": "object", "additionalProperties": { "$ref": "#/$defs/json_value" } }
          }
        },
        "timestamp": { "type": "integer", "minimum": 0 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_type", "occurred_at", "request_id", "trace_id", "tenant_id", "project_id", "actor_identity_id", "payload", "contract_version"],
      "properties": {
        "event_id": { "$ref": "#/$defs/identifier" },
        "event_type": { "enum": ["PROJECT_CREATED", "TASK_STATUS_CHANGED", "PLUGIN_STATUS_CHANGED", "ASSET_STATUS_CHANGED"] },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "request_id": { "$ref": "#/$defs/identifier" },
        "trace_id": { "$ref": "#/$defs/identifier" },
        "tenant_id": { "$ref": "#/$defs/identifier" },
        "project_id": { "$ref": "#/$defs/identifier" },
        "actor_identity_id": { "$ref": "#/$defs/identifier" },
        "payload": { "type": "object" },
        "contract_version": { "$ref": "#/$defs/version" }
      },
      "allOf": [
        { "if": { "properties": { "event_type": { "const": "PROJECT_CREATED" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/project_created_payload" } } } },
        { "if": { "properties": { "event_type": { "const": "TASK_STATUS_CHANGED" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/task_status_changed_payload" } } } },
        { "if": { "properties": { "event_type": { "const": "PLUGIN_STATUS_CHANGED" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/plugin_status_changed_payload" } } } },
        { "if": { "properties": { "event_type": { "const": "ASSET_STATUS_CHANGED" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/asset_status_changed_payload" } } } }
      ]
    },
    "project_created_payload": {
      "type": "object", "additionalProperties": false, "required": ["project_id", "status"],
      "properties": { "project_id": { "$ref": "#/$defs/identifier" }, "status": { "enum": ["draft", "active", "archived"] } }
    },
    "task_status_changed_payload": {
      "type": "object", "additionalProperties": false, "required": ["task_id", "previous_status", "current_status"],
      "properties": { "task_id": { "$ref": "#/$defs/identifier" }, "previous_status": { "enum": ["queued", "running", "waiting_human", "paused", "completed", "failed", "cancelled"] }, "current_status": { "enum": ["queued", "running", "waiting_human", "paused", "completed", "failed", "cancelled"] } }
    },
    "plugin_status_changed_payload": {
      "type": "object", "additionalProperties": false, "required": ["plugin_id", "previous_status", "current_status"],
      "properties": { "plugin_id": { "$ref": "#/$defs/identifier" }, "previous_status": { "enum": ["discovered", "validated", "installed", "enabled", "disabled", "failed", "uninstalled"] }, "current_status": { "enum": ["discovered", "validated", "installed", "enabled", "disabled", "failed", "uninstalled"] } }
    },
    "asset_status_changed_payload": {
      "type": "object", "additionalProperties": false, "required": ["asset_id", "asset_version_id", "status"],
      "properties": { "asset_id": { "$ref": "#/$defs/identifier" }, "asset_version_id": { "$ref": "#/$defs/identifier" }, "status": { "enum": ["pending", "available", "invalidated", "failed"] } }
    }
  }
}
