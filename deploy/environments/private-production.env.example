AI_AGENT_ENVIRONMENT=production
AI_AGENT_HOST=0.0.0.0
AI_AGENT_PORT=8080
AI_AGENT_DATA_ROOT=/var/lib/ai-agent
AI_AGENT_DATABASE_URL=postgresql://REPLACE_AT_DEPLOYMENT
AI_AGENT_OBJECT_ROOT=/var/lib/ai-agent/objects
AI_AGENT_SECRET_PROVIDER=vault
AI_AGENT_LOG_FORMAT=json
AI_AGENT_METRICS_ENABLED=true
